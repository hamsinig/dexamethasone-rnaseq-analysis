cat > .gitignore <<'EOF'
# Large sequencing data
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sra

# Alignment files
*.bam
*.bai
*.sam
*.cram
*.crai

# Reference genome and annotation
*.fa
*.fasta
*.fai
*.gtf
*.gff

# Large intermediate files
*.bed
*.bigWig

# Python and R temporary files
__pycache__/
*.pyc
.ipynb_checkpoints/
.Rhistory
.RData

# Virtual environments
.venv/
venv/
conda_env/

# macOS metadata
.DS_Store
._*

# Temporary and log files
*.tmp
*.log
EOF
